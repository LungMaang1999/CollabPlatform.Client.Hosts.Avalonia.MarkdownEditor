  <!-- ── 提示块：admonition 存在时两档结构，缺失时普通引用 ───────── -->
  <element id="builtin-quote-present" applies-to="Quote" selector="admonition:present">
    <structure>
      <part slot="root" tag="blockquote" class="admonition" class-recipe="admonition-kind" css="accent-adm">
        <part slot="title" tag="p" class="admonition-title">
          <part slot="icon" tag="span" class="admonition-icon" content="admonition-icon"/>
          <part slot="title-text" tag="span" class="admonition-title-text" content="admonition-title-text"/>
        </part>
        <part slot="content" content="children"/>
      </part>
    </structure>
  </element>

